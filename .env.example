NODE_ENV=development
HOST=0.0.0.0
PORT=8080
KOKORO_DOMAIN=dev.kokoro.localhost
# Shared only with the server-side kokoro-app BFF.
KOKORO_GATEWAY_SHARED_SECRET=replace-with-web-bff-secret
# Session upstream can be omitted for a liveness-only local boot; /readyz stays 503.
KOKORO_SESSION_BASE_URL=http://127.0.0.1:8085
# Separate gateway -> session service credential; never expose to the browser.
KOKORO_SESSION_INTERNAL_SECRET=replace-with-session-secret
KOKORO_SESSION_SERVICE_VALUE=kokoro-gateway
KOKORO_UPSTREAM_TIMEOUT_MS=30000
KOKORO_GATEWAY_BODY_LIMIT_BYTES=10485760
