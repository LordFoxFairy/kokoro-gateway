NODE_ENV=development
HOST=0.0.0.0
PORT=8080
KOKORO_DOMAIN=dev.kokoro.localhost
# Shared only with the server-side kokoro-app BFF.
KOKORO_GATEWAY_SHARED_SECRET=replace-with-web-bff-secret
# Session upstream can be omitted for a liveness-only local boot; /readyz stays 503.
KOKORO_SESSION_BASE_URL=http://127.0.0.1:8085
# Separate gateway -> session service credential; never expose to the browser.
KOKORO_SESSION_INTERNAL_SECRET=replace-with-session-secret
KOKORO_SESSION_SERVICE_VALUE=kokoro-gateway
# Optional business upstreams. Each is server-only and can use its own internal secret.
KOKORO_USER_BASE_URL=http://127.0.0.1:4211
KOKORO_HUB_BASE_URL=http://127.0.0.1:4251
KOKORO_SYSTEM_BASE_URL=http://127.0.0.1:4240
KOKORO_AGENT_BASE_URL=http://127.0.0.1:4260
KOKORO_PAYMENT_BASE_URL=http://127.0.0.1:4241
KOKORO_BILLING_BASE_URL=http://127.0.0.1:4245
# KOKORO_USER_INTERNAL_SECRET=replace-with-user-secret
# KOKORO_HUB_INTERNAL_SECRET=replace-with-hub-secret
# KOKORO_SYSTEM_INTERNAL_SECRET=replace-with-system-secret
# KOKORO_AGENT_INTERNAL_SECRET=replace-with-agent-secret
# KOKORO_PAYMENT_INTERNAL_SECRET=replace-with-payment-secret
# KOKORO_BILLING_INTERNAL_SECRET=replace-with-billing-secret
KOKORO_UPSTREAM_TIMEOUT_MS=30000
KOKORO_GATEWAY_BODY_LIMIT_BYTES=10485760
